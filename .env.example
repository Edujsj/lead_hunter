# ==============================================================================
# Maps Lead Hunter — variáveis de ambiente
# Copie para .env.local e preencha o que for usar:
#   cp .env.example .env.local
# Nenhuma variável é obrigatória: sem nenhuma delas o app roda em modo DEMO
# (dados simulados) e a IA cai num fallback com textos genéricos.
# ==============================================================================

# ─── Modo de coleta ───────────────────────────────────────────────────────────
# "true"  → usa o crawler real do Google Maps via Playwright (lib/crawler/googleMapsCrawler.ts)
# qualquer outro valor / ausente → modo mock, dados gerados localmente
# Atenção: com "true" é preciso ter os browsers do Playwright instalados:
#   npx playwright install chromium
USE_REAL_CRAWLER=false

# ─── Crawler (só têm efeito com USE_REAL_CRAWLER=true) ────────────────────────
# Timeout por página, em ms. Default 30000. O código limita o máximo a 60000.
CRAWLER_TIMEOUT=30000

# Quantos estabelecimentos extrair por busca. Default 15. O código limita o máximo a 20.
CRAWLER_MAX_RESULTS=15

# ─── Groq (enriquecimento com IA — botão "IA" / deep crawl) ───────────────────
# Usada em lib/crawler/deepCrawler.ts para gerar proposta de valor, headlines,
# FAQ e o prompt da landing page (modelo llama-3.3-70b-versatile).
# Sem a chave o endpoint /api/deep-crawl continua respondendo 200, porém com
# conteúdo de fallback estático em vez de gerado por IA.
# Gere a sua em https://console.groq.com/keys
GROQ_API_KEY=

# ─── Serper.dev (NÃO está ativo hoje) ─────────────────────────────────────────
# Aparece apenas dentro de um bloco comentado em lib/mapsScanner.ts:186.
# Defini-la não muda nada enquanto aquele código não for descomentado.
# Deixada aqui só como referência do caminho "produção sem Playwright".
# SERPER_API_KEY=
